{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "1160px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "navy", "name": "Navy", "color": "#081A3B" },
				{ "slug": "ink", "name": "Ink", "color": "#0B1530" },
				{ "slug": "blue", "name": "AXD Blue", "color": "#0A5BEF" },
				{ "slug": "violet", "name": "Violet", "color": "#6A2EE8" },
				{ "slug": "purple", "name": "AXD Purple", "color": "#8525DC" },
				{ "slug": "lavender", "name": "Lavender", "color": "#B98CFF" },
				{ "slug": "muted", "name": "Muted Text", "color": "#4A5573" },
				{ "slug": "off-white", "name": "Off White", "color": "#F5F7FB" },
				{ "slug": "line", "name": "Line", "color": "#E3E8F2" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			],
			"gradients": [
				{ "slug": "axd-button", "name": "AXD Button", "gradient": "linear-gradient(90deg,#1150F2 0%,#3F3CF2 50%,#8A1FE8 100%)" },
				{ "slug": "axd-navy", "name": "AXD Navy Panel", "gradient": "linear-gradient(110deg,#081A3B 0%,#0B2A5E 45%,#0E3FA8 80%,#1450D8 100%)" },
				{ "slug": "axd-text", "name": "AXD Text Accent", "gradient": "linear-gradient(90deg,#6A2EE8,#8525DC)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-var.woff2" ]
						}
					]
				},
				{
					"slug": "jakarta",
					"name": "Plus Jakarta Sans",
					"fontFamily": "'Plus Jakarta Sans', Inter, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/plus-jakarta-sans-var.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "14px", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "17px", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "20px", "fluid": false },
				{ "slug": "x-large", "name": "Extra Large", "size": "clamp(28px, 2.9vw, 42px)", "fluid": false },
				{ "slug": "xx-large", "name": "Huge", "size": "clamp(34px, 3.8vw, 54px)", "fluid": false }
			]
		},
		"spacing": {
			"units": [ "px", "%", "rem", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "16px",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" }
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--jakarta)",
					"fontWeight": "800",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.14"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.08" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "20px", "lineHeight": "1.25" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--blue)" },
				":hover": { "color": { "text": "#0848C4" } }
			},
			"button": {
				"border": { "radius": "999px" },
				"color": {
					"gradient": "var(--wp--preset--gradient--axd-button)",
					"text": "var(--wp--preset--color--white)"
				},
				"spacing": { "padding": { "top": "0", "bottom": "0", "left": "26px", "right": "26px" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--jakarta)",
					"fontSize": "15px",
					"fontWeight": "700",
					"lineHeight": "1"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-with-title", "title": "Page with Title (simple text page)", "postTypes": [ "page" ] },
		{ "name": "page-profile", "title": "Profile Card (digital business card)", "postTypes": [ "page" ] }
	]
}
